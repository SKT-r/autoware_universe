<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="input_imu_raw" default="/sensing/imu/tamagawa/imu_raw"/>
  <arg name="input_odom" default="/localization/kinematic_state"/>
  <arg name="input_pose_ndt" default="/localization/pose_estimator/pose_with_covariance"/>
  <arg name="input_twist" default="/sensing/vehicle_velocity_converter/twist_with_covariance"/>

  <!-- Gyro Bias Estimator Original -->
  <node pkg="autoware_imu_corrector" exec="gyro_bias_estimator_node" name="gyro_bias_estimator" output="both">
    <remap from="~/input/imu_raw" to="$(var input_imu_raw)"/>
    <remap from="~/input/odom" to="$(var input_odom)"/>
    <remap from="~/output/gyro_bias" to="/sensing/imu/gyro_bias"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/gyro_bias_estimator.param.yaml"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

  <!-- IMU Corrector Original -->
  <node pkg="autoware_imu_corrector" exec="imu_corrector_node" name="imu_corrector" output="both">
    <remap from="input" to="$(var input_imu_raw)"/>
    <remap from="output" to="/sensing/imu/imu_data"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

  <!-- Gyro Bias+Scale Estimator Sergio -->
  <node pkg="autoware_imu_corrector" exec="gyro_bias_estimator_sergio_node" name="gyro_bias_scale_estimator_sergio" output="both">
    <remap from="~/input/imu_raw" to="$(var input_imu_raw)"/>
    <remap from="~/input/odom" to="$(var input_odom)"/>
    <remap from="~/input/pose_ndt" to="$(var input_pose_ndt)"/>
    <remap from="~/output/gyro_bias" to="/sensing/imu/gyro_bias_sergio"/>
    <remap from="~/output/gyro_scale" to="/sensing/imu/gyro_scale_sergio"/>
    <remap from="~/output/imu_scaled" to="/sensing/imu/imu_scaled_debug"/>
    <remap from="~/output/gyro_vector_debug" to="/sensing/imu/gyro_debug_sergio"/>
    <remap from="~/output/scale_vector_debug" to="/sensing/imu/scale_debug_sergio"/>
    <remap from="~/output/new_scale_vector_debug" to="/sensing/imu/new_scale_debug_sergio"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/gyro_bias_estimator.param.yaml"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/gyro_scale_estimator.param.yaml"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

  <!-- IMU Corrector Sergio -->
  <node pkg="autoware_imu_corrector" exec="imu_corrector_sergio_node" name="imu_corrector_sergio" output="both">
    <remap from="input" to="$(var input_imu_raw)"/>
    <remap from="gyro_bias_input" to="/sensing/imu/gyro_bias_sergio"/>
    <remap from="gyro_scale_input" to="/sensing/imu/gyro_scale_sergio"/>
    <remap from="output" to="/sensing/imu/imu_data_sergio"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

  <!-- Gyro Bias Estimator Sakata -->
  <node pkg="autoware_imu_corrector" exec="gyro_bias_estimator_sakata_node" name="gyro_bias_estimator_sakata" output="both">
    <remap from="~/input/imu_raw" to="$(var input_imu_raw)"/>
    <remap from="~/input/odom" to="$(var input_odom)"/>
    <remap from="/sensing/vehicle_velocity_converter/twist_with_covariance" to="$(var input_twist)"/>
    <remap from="~/output/gyro_bias" to="/sensing/imu/gyro_bias_sakata"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/gyro_bias_estimator.param.yaml"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

  <!-- IMU Corrector Sakata -->
  <node pkg="autoware_imu_corrector" exec="imu_corrector_sakata_node" name="imu_corrector_sakata" output="both">
    <remap from="input" to="$(var input_imu_raw)"/>
    <remap from="gyro_bias" to="/sensing/imu/gyro_bias_sakata"/>
    <remap from="output" to="/sensing/imu/imu_data_sakata"/>
    <param from="$(find-pkg-share autoware_imu_corrector)/config/imu_corrector.param.yaml"/>
  </node>

</launch>